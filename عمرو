// UPDATED: حفظ صفحة التمام إلى Excel بنظام العمودين
async function saveTamamToExcel() {
  const fileName = prompt('أدخل اسم ملف Excel:', `${tamamTitle.value || 'التمام'}_${new Date().toISOString().slice(0, 10)}`);
  
  if (!fileName) return;
  
  showProgress(true, 'جارٍ تجهيز ملف Excel...');
  
  try {
    const workbook = new ExcelJS.Workbook();
    const sheet = workbook.addWorksheet("التمام");
    
    // إعداد الصفحة بحجم A4
    sheet.pageSetup = {
      paperSize: 9, // A4
      orientation: 'portrait',
      margins: { left: 0.7, right: 0.7, top: 0.75, bottom: 0.75, header: 0.3, footer: 0.3 },
      fitToPage: true,
      fitToWidth: 1,
      fitToHeight: 1
    };
    
    // إعداد اتجاه النص من اليمين لليسار
    sheet.views = [{ state: 'normal', rightToLeft: true }];
    
    // العنوان الرئيسي
    sheet.mergeCells('A1:F1');
    const title = sheet.getCell('A1');
    title.value = tamamTitle.value || 'التمام';
    title.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF007BFF' } };
    title.font = { name: 'Cairo', size: 16, bold: true, color: { argb: 'FFFFFFFF' } };
    title.alignment = { horizontal: 'center', vertical: 'middle' };
    
    let currentRow = 3;
    
    // فرز الجداول حسب الترتيب المحدد
    const sortedFiles = [...filesData].sort((a, b) => {
      const orderA = tableOrder[a.id] || filesData.indexOf(a) + 1;
      const orderB = tableOrder[b.id] || filesData.indexOf(b) + 1;
      return orderA - orderB;
    });
    
    // تقسيم الجداول إلى عمودين
    const leftColumnFiles = [];
    const rightColumnFiles = [];
    
    sortedFiles.forEach((fd, index) => {
      if (index % 2 === 0) {
        leftColumnFiles.push(fd);
      } else {
        rightColumnFiles.push(fd);
      }
    });
    
    // إضافة الجداول في العمودين
    let leftColumnCurrentRow = currentRow;
    let rightColumnCurrentRow = currentRow;
    
    // العمود الأيسر
    for (const fd of leftColumnFiles) {
      leftColumnCurrentRow = addTableToExcelTwoColumns(sheet, fd, leftColumnCurrentRow, 'A');
      leftColumnCurrentRow += 2; // مسافة بين الجداول
    }
    
    // العمود الأيمن
    for (const fd of rightColumnFiles) {
      rightColumnCurrentRow = addTableToExcelTwoColumns(sheet, fd, rightColumnCurrentRow, 'D');
      rightColumnCurrentRow += 2; // مسافة بين الجداول
    }
    
    // ضبط عرض الأعمدة
    sheet.columns = [
      { width: 15 }, { width: 15 }, { width: 15 },
      { width: 15 }, { width: 15 }, { width: 15 }
    ];
    
    // حفظ الملف
    const buffer = await workbook.xlsx.writeBuffer();
    saveAs(new Blob([buffer]), `${fileName}.xlsx`);
    
    showProgress(false);
    showNotification('تم حفظ ملف Excel بنجاح', 'success');
  } catch (error) {
    console.error('Excel export error:', error);
    showProgress(false);
    showNotification('حدث خطأ أثناء حفظ ملف Excel', 'error');
  }
}

