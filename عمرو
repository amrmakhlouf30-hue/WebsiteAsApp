// تحديث قيمة خلية
function updateCellValue(fileId, rowIndex, colIndex, value) {
  const fd = filesData.find(x => x.id === fileId);
  if (!fd || !fd.rows[rowIndex]) return;
  
  fd.rows[rowIndex][colIndex] = value;
  
  // إعادة تطبيق التسكين الذكي إذا كان مطبقاً
  if (fd._assigned) {
    applyAutoMapping(fd.id);
  }
  
  showNotification('تم تحديث الخلية', 'success');
}

// إضافة صف جديد
function addRowToFile(fileId) {
  const fd = filesData.find(x => x.id === fileId);
  if (!fd) return;
  
  const newRow = new Array(fd.headers.length).fill('');
  fd.rows.push(newRow);
  
  // إعادة تطبيق التسكين الذكي إذا كان مطبقاً
  if (fd._assigned) {
    applyAutoMapping(fd.id);
  }
  
  renderAllEditFiles();
  showNotification('تم إضافة صف جديد', 'success');
}

// حذف صف
function deleteRowFromFile(fileId, rowIndex) {
  const fd = filesData.find(x => x.id === fileId);
  if (!fd || !fd.rows[rowIndex]) return;
  
  if (confirm('هل تريد حذف هذا الصف؟')) {
    fd.rows.splice(rowIndex, 1);
    
    // إعادة تطبيق التسكين الذكي إذا كان مطبقاً
    if (fd._assigned) {
      applyAutoMapping(fd.id);
    }
    
    renderAllEditFiles();
    showNotification('تم حذف الصف', 'success');
  }
}

// إضافة عمود جديد
function addColumnToFile(fileId) {
  const fd = filesData.find(x => x.id === fileId);
  if (!fd) return;
  
  const colName = prompt('أدخل اسم العمود الجديد:');
